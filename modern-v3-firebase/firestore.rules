rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Status dibandingkan case-insensitive agar tidak ada outage akibat
    // perbedaan penulisan 'Aktif' vs 'aktif' pada profil existing.
    function active() {
      return signedIn() && profile().status.lower() == 'aktif';
    }

    function roleIs(role) {
      return active() && profile().role.lower() == role.lower();
    }

    function administrator() {
      return roleIs('Superadmin') || roleIs('Admin');
    }

    function privilegedEntity(entity) {
      return entity in [
        'pengguna', 'pengaturan', 'transaksi', 'booking', 'approval', 'kuitansi', 'voucher',
        'pettycash', 'bukubank', 'kartuanggaran', 'piutang', 'hutang',
        'budgetcontrol', 'kartupiutang', 'kartubarangmasuk', 'barangkeluar',
        'komisi', 'pph', 'bphtb', 'pengajuankpr', 'pencairankpr', 'spkborong',
        'pricelist', 'targetmarketing', 'tagihan'
      ];
    }

    match /users/{userId} {
      allow get: if active() && (request.auth.uid == userId || roleIs('Superadmin'));
      allow list: if roleIs('Superadmin');
      allow create, update, delete: if false;
    }

    match /entities/{entity}/records/{recordId} {
      // Matriks role yang disetujui dikunci di level database:
      // semua role aktif boleh membaca seluruh entitas operasional,
      // KECUALI direktori pengguna ('pengguna') yang hanya boleh dibaca
      // Superadmin. Sebelumnya aturan ini hanya ada di kode aplikasi dan
      // bisa dilewati lewat akses SDK/REST langsung.
      allow read: if active() && (entity != 'pengguna' || roleIs('Superadmin'));

      allow create: if administrator()
        && !privilegedEntity(entity)
        && request.resource.data.id == recordId;

      // createdAt immutable: update tidak boleh mengubah nilai createdAt
      // yang sudah tersimpan pada dokumen.
      allow update: if administrator()
        && !privilegedEntity(entity)
        && request.resource.data.id == recordId
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);

      allow delete: if administrator() && !privilegedEntity(entity);
    }

    match /auditLogs/{logId} {
      allow read: if roleIs('Superadmin');
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
